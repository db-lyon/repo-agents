  "description": "Engine for the repo-agents action suite: flowkit flows that triage, resolve, review, close out and release with Claude agents, configured per repository.",
  "type": "module",
  "license": "MIT",
  "author": "David Bingham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-lyon/repo-agents.git"
  },
